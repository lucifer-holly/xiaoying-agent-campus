# 服务器上的 /srv/xiaoying-agent/.env：只放在服务器上，属主 root、权限 600。
# systemd 以 root 读取它再启动服务，服务用户 caddy 不需要、也读不到这个文件。
# scripts/deploy.sh 不会创建或覆盖它。

# 真实模型（必填，否则页面只有回放）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.8-max
LLM_TIMEOUT_S=30

# 访问口令（可选）：留空时任何人打开页面都能直接运行；填写后页面会要求输入口令
DEMO_ACCESS_CODE=
# 按 IP 限流：次数/秒数
DEMO_RATE_LIMIT=5/600
# 每天最多真实调用次数（跨重启累计，超过后页面自动切回放）
DEMO_DAILY_LIMIT=50
# 同时运行的上限
DEMO_MAX_CONCURRENCY=2

# 监听端口（只监听 127.0.0.1，由 Caddy 反代；不要用 booksprite 的 3000）
PORT=8710
