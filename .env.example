# 真实模型（--llm real）需要的变量；只跑 --llm mock 时无需配置。
# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交。

# 阿里云百炼 API Key（必填，空字符串按未配置处理）
LLM_API_KEY=
# OpenAI 兼容端点；留空使用默认 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 模型名；留空使用默认 qwen3.8-max
LLM_MODEL=

# 可选：请求超时（秒，默认 60）、温度（默认 0.2）、是否开启思考模式（默认 false）
LLM_TIMEOUT_S=
LLM_TEMPERATURE=
LLM_ENABLE_THINKING=
